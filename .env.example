# ── App ───────────────────────────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
APP_VERSION=0.1.0
FRONTEND_URL=https://snapit.ink

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://snap:snap@localhost:3306/snap_dev

# ── Redis (Celery broker + rate limiter) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email — Resend (primary) ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Snapit <hello@snapit.ink>

# ── Email — SMTP fallback (Gmail app password recommended) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hello@snapit.ink
SMTP_PASSWORD=your-app-password

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret
PAYSTACK_PLAN_PRO=PLN_xxxxxxxxxxxx
PAYSTACK_PLAN_PRO_AI=PLN_xxxxxxxxxxxx
PAYSTACK_PLAN_TEAM=PLN_xxxxxxxxxxxx

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Docker Compose (lets you run `docker compose` without -f) ─────────────────
COMPOSE_FILE=docker-compose.prod.yml
REGISTRY_IMAGE=ghcr.io/your-github-username/snap_be
IMAGE_TAG=latest
